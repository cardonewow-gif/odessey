# Odysseus UI — safer defaults for LAN/Tailscale/reverse-proxy hosting
# Copy to .env on the Mac, then replace the placeholder origins and secrets.

AUTH_ENABLED=true
LOCALHOST_BYPASS=false
ODYSSEUS_SINGLE_USER=0

# Use HTTPS through Tailscale Funnel, Caddy, nginx, or another TLS proxy
# before setting this to true. Leave false only for plain HTTP LAN testing.
SECURE_COOKIES=true

# Comma-separated browser origins that may call the API.
# Examples:
# ALLOWED_ORIGINS=https://odysseus.example.com,https://macbook.tailnet.ts.net
ALLOWED_ORIGINS=https://your-odysseus-host.example

# First-run setup is local-host only by default. Prefer opening /setup on the
# Mac itself, then log in from your PC/phone after the admin user exists.
ODYSSEUS_ALLOW_REMOTE_SETUP=false
# Optional one-time remote bootstrap token:
# ODYSSEUS_SETUP_TOKEN=replace_with_a_long_random_value

# Keep user-configured CalDAV from reaching private services.
# Set to 1 only if you intentionally connect CalDAV to a LAN/VPN host.
ODYSSEUS_ALLOW_PRIVATE_CALDAV=0

# Online/shared deployments should block private/loopback embedding endpoints.
# Set false only when an admin intentionally points embeddings at local Ollama.
EMBEDDING_BLOCK_PRIVATE_IPS=true

# Keep schedulers in-process for a single Mac-hosted instance.
ODYSSEUS_INPROCESS_POLLERS=1
ODYSSEUS_INPROCESS_TASKS=1
